{"atMs":15410,"name":"native.tool.requested","status":"running","model":"muse-spark-1.3-contributor","provider":"meta","data":{"toolCall":4,"callId":"call_01a192727dc170e4bc866426c243cb40","namespace":"trebell_terminal","name":"run","terminalAudit":{"executable":"bash","commandHash":"4634201d4df3e5c8fb6c7f97d6b2350beef3cd35cf14a9082e414c17cc3e923e","networkLike":false,"packageManager":false,"localFileMutationLike":true,"persistentMutationLike":false,"persistentMutationKind":null,"hosts":[],"redactedCommand":"bash -lc cat > /tmp/fit.py << 'PY'\nimport csv, json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef L(x, x0, gamma, A, C):\n    return A * gamma**2 / ((x - x0)**2 + gamma**2) + C\n\nwl=[]; em=[]; ex=[]\nwith open('/app/spectra.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        wl.append(float(row['wavelength']))\n        em.append(float(row['emission']))\n        ex.append(float(row['excitation']))\nx=np.array(wl); yem=np.array(em); yex=np.array(ex)\n\ndef fit(y):\n    # initial guesses: x0 at max, gamma ~40, A ~ max-min, C ~ min\n    p0=[x[np.argmax(y)], 40.0, float(np.max(y)-np.min(y)), float(np.min(y))]\n    popt, _ = curve_fit(L, x, y, p0=p0, maxfev=20000)\n    ypred=L(x,*popt)\n    ss_res=np.sum((y-ypred)**2)\n    ss_tot=np.sum((y-np.mean(y))**2)\n    r2=1-ss_res/ss_tot\n    x0,gamma,A,C=popt\n    return {\"x0\":round(float(x0),6),\"gamma\":round(float(gamma),6),\"amplitude\":round(float(A),6),\"offset\":round(float(C),6),\"r_squared\":round(float(r2),6),\"fwhm\":round(float(2*gamma),6)}\n\nres={\"Emission\":fit(yem),\"Excitation\":fit(yex)}\nprint(json.dumps(res,indent=2))\nwith open('/app/results.json','w') as f:\n    json.dump(res,f,indent=2)\nPY\npython3 /tmp/fit.py","gateCommand":"bash -lc cat > /tmp/fit.py << 'PY'\nimport csv, json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef L(x, x0, gamma, A, C):\n    return A * gamma**2 / ((x - x0)**2 + gamma**2) + C\n\nwl=[]; em=[]; ex=[]\nwith open('/app/spectra.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        wl.append(float(row['wavelength']))\n        em.append(float(row['emission']))\n        ex.append(float(row['excitation']))\nx=np.array(wl); yem=np.array(em); yex=np.array(ex)\n\ndef fit(y):\n    # initial guesses: x0 at max, gamma ~40, A ~ max-min, C ~ min\n    p0=[x[np.argmax(y)], 40.0, float(np.max(y)-np.min(y)), float(np.min(y))]\n    popt, _ = curve_fit(L, x, y, p0=p0, maxfev=20000)\n    ypred=L(x,*popt)\n    ss_res=np.sum((y-ypred)**2)\n    ss_tot=np.sum((y-np.mean(y))**2)\n    r2=1-ss_res/ss_tot\n    x0,gamma,A,C=popt\n    return {\"x0\":round(float(x0),6),\"gamma\":round(float(gamma),6),\"amplitude\":round(float(A),6),\"offset\":round(float(C),6),\"r_squared\":round(float(r2),6),\"fwhm\":round(float(2*gamma),6)}\n\nres={\"Emission\":fit(yem),\"Excitation\":fit(yex)}\nprint(json.dumps(res,indent=2))\nwith open('/app/results.json','w') as f:\n    json.dump(res,f,indent=2)\nPY\npython3 /tmp/fit.py"}}}
