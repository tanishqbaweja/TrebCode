 return np.mod(A.dot(B),2)\nP=np.eye(8,dtype=int)\nfor t in range(1,17):\n P=matmul(M,P) if False else np.mod(M.dot(P if t==1 else Pwr),2) if False else None\n # simpler iterative\nPwr=np.eye(8,dtype=int)\nfor t in range(1,17):\n Pwr=np.mod(M.dot(Pwr),2)\n print(t, 'I?' , np.array_equal(Pwr%2, np.eye(8,dtype=int)))\n# rows for first byte\nPwr=np.eye(8,dtype=int)\nrows=[]\nfor t in range(8):\n if t==0: Mp=np.eye(8,dtype=int)\n else: Mp=np.mod(np.linalg.matrix_power(M.astype(int),t)%2,2)  # careful: matrix_power over ints then mod may overflow but small\n # recompute mod2 power properly\n rows.append('t=%d row=%s'%(t, str(np.mod(np.linalg.matrix_power(M,t),2)[t] if t<8 else '?')))\nprint(rows)\n# proper mod-2 powers\ndef mpow(M,e):\n R=np.eye(8,dtype=int); B=M.copy()\n while e:\n  if e&1: R=np.mod(R.dot(B),2)\n  B=np.mod(B.dot(B),2); e>>=1\n return R\nfor t in range(8):\n print(t, mpow(M,t)[t].tolist())\nA=np.array([mpow(M,t)[t] for t in range(8)])%2\nprint('A=\\n',A)\n# rank\ndef rank(A):\n A=A.copy()%2; r=0\n for c in range(8):\n  piv=None\n  for i in range(r,len(A)):\n   if A[i,c]: piv=i;break\n  if piv is None: continue\n  A[[r,piv]]=A[[piv,r]]\n  for i in range(len(A)):\n   if i!=r and A[i,c]: A[i]^=A[r]\n  r+=1\n return r\nprint('rank A',rank(A))\n# keystream byte for the known key\nfrom cipher import StreamCipher\nkey=np.array([1,0,1,1,0,1,0,1],dtype=np.uint8)\nc=StreamCipher(key)\nprint([hex(c._get_keystream_byte()) for _ in range(4)])\n# solve: A key = b where b bits MSB first of 0x99 = 1,0,0,1,1,0,0,1\nb=np.array([1,0,0,1,1,0,0,1])\nprint('A.dot(key)%2 =', np.mod(A.dot(key),2))\nPY"}}}
