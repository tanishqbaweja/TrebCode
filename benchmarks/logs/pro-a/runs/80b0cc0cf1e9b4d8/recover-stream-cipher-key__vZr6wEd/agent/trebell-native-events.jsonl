and A[i,c]: A[i]^=A[r]\n  r+=1\n return r, A\nprint('rank M:',rank_gf2(M)[0])\n# keystream check\nfrom cipher import StreamCipher\nkey=np.array([1,0,1,1,0,1,0,1],dtype=np.uint8)\n# read pairs\npairs=[]\nwith open('/app/known_pairs.txt') as f:\n for line in f:\n  ph,ch=line.strip().split(':')\n  pairs.append((bytes.fromhex(ph),bytes.fromhex(ch)))\nfor pt,ct in pairs:\n ks=bytes(a^b for a,b in zip(pt,ct))\n print(pt[:10],ks.hex())\n# check same prefix: first keystream byte\n# build equations\nPY"}}}
