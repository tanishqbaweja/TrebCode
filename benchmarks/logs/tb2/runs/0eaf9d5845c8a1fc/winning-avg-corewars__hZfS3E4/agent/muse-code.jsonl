{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c396","stream":{"kind":"session","id":"f2a05895-04b9-4c6f-998e-3f6872265681"},"sequence":37,"recorded_at":1780531400000070,"record_type":"event","durability":"durable","causation_id":"01a18dc5-58af-7b52-a675-b8da45771d70","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a18dc5-58af-7b52-a675-b8da45771d70","event":{"chunk":"{\n  \"chunk_id\": \"exec-1-1\",\n  \"command\": \"ls -R; echo ---; cat warriors/*.red 2>/dev/null; echo ===; cat *.red 2>/dev/null; echo ===; cat pmars* 2>/dev/null; pmars --help 2>&1 | head -n 80\",\n  \"description\": \"List workspace and show warriors\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"[unified exec output: 60523 invalid UTF-8 bytes replaced with U+FFFD]\\n.:\\npmars-0.9.4\\npmars_0.9.4-1.debian.tar.xz\\npmars_0.9.4-1.dsc\\npmars_0.9.4.orig.tar.xz\\nwarriors\\n\\n./pmars-0.9.4:\\nAUTHORS\\nCONTRIB\\nCOPYING\\nChangeLog\\nREADME\\nconfig\\ndebian\\ndoc\\nsrc\\nwarriors\\n\\n./pmars-0.9.4/config:\\n88.opt\\n94.opt\\n94b.opt\\n94m.opt\\n94nop.opt\\n94t.opt\\n94x.opt\\n94xm.opt\\nicws.opt\\nlp.opt\\nmp.opt\\nmw.mac\\nnano.opt\\npmars.mac\\ntiny.opt\\ntinylp.opt\\n\\n./pmars-0.9.4/debian:\\nchangelog\\ncompat\\ncontrol\\ncopyright\\nmanpages\\npatches\\npmars.examples\\npmars.install\\nrules\\nsource\\nwatch\\n\\n./pmars-0.9.4/debian/patches:\\nbuildflags.patch\\nfix-implicit-sighandler.patch\\nmanpage.patch\\nprintf.patch\\nseries\\n\\n./pmars-0.9.4/debian/source:\\nformat\\n\\n./pmars-0.9.4/doc:\\nMakefile\\ncorewar-faq.html\\ncorewar-glossary.html\\nmakedoc.ex\\npmars.6\\npmars.txt\\nprimer.94\\nprimer.cdb\\nredcode.ref\\nwhatsnew.080\\n\\n./pmars-0.9.4/src:\\nMakefile\\nMakefile.djg\\nMakefile.wat\\nalldisp.c\\nasm.c\\nasm.h\\nasm.o\\ncdb.c\\ncdb.o\\nclparse.c\\nclparse.o\\nconfig.h\\ncurdisp.c\\ndisasm.c\\ndisasm.o\\neval.c\\neval.o\\nglobal.c\\nglobal.h\\nglobal.o\\ngrxdisp.c\\ngtdisp.c\\nlnxdisp.c\\nlnxdisp.h\\npmars\\npmars.c\\npmars.o\\npmarsicn.h\\npos.c\\npos.o\\nsim.c\\nsim.h\\nsim.o\\nstr_eng.c\\nstr_eng.o\\ntoken.c\\ntoken.o\\nuidisp.c\\nxgraphio.c\\nxwindisp.c\\nxwindisp.h\\n\\n./pmars-0.9.4/warriors:\\naeka.red\\nflashpaper.red\\npspace.red\\nrave.red\\ntest_eval.red\\nvalidate.red\\n\\n./warriors:\\ng2-clear.red\\npaper.red\\nsnake.red\\nstone.red\\nvampire.red\\n---\\n;redcode-94\\n;name G2-Clear\\n;author Unknown\\n;source https://corewar.co.uk/clear.htm\\n;strategy Simple clear loop with decrementing pointer\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\n\\ndec     equ     2700                ; Decrement value for bomb counter\\ngate    equ     clear-4             ; Gate location relative to clear\\n\\n        org     clear-1             ; Start execution before clear\\n\\n; Main data and bomb structures\\nbptr    dat     bomb,       9       ; Pointer to bomb with offset 9\\nbomb    spl     #dec,       11      ; Split with decrement value, creates processes\\nclear   mov     *bptr,      >gate   ; Move bomb contents through gate pointer\\n        mov     *bptr,      >gate   ; Second move for double clearing\\n        djn.f   clear,      }bomb   ; Decrement and jump if not zero (loop control)\\n\\n        end\\n;redcode-94\\n;name Paper\\n;author mzvince (Everything2)\\n;source https://everything2.com/title/corewars+replicator\\n;strategy Classic paper replicator - fast copying beats stone bombers  \\n;assert CORESIZE == 8000\\n\\nstep    equ 2667    ; coprime step for full coverage\\n\\nstart   spl 1       ; split for more processes\\n        \\nloop    mov copy, *ptr\\n        add #1, ptr\\n        mov copy, @ptr\\n        add #step, ptr\\n        jmp loop\\n\\ncopy    spl 0, 0\\nptr     dat step, step*2\\n\\n        end start;redcode-94\\n;name Snake\\n;author Wayne Sheppard\\n;source https://corewar.co.uk/snake.htm\\n;strategy Pitbomber-impspiral\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\n\\n;Dan only plays bombers and imps on the hill.  But I am hoping\\n;that he will go with a paper or scanner\\n\\n;Snake is a vampire and imp\\n;Night Crawler would lose vs paper\\n;The vampire should gain enough wins to beat paper\\n;Should still have a winning record vs scanners\\n;Probably lose vs other imps\\n\\ndist    equ 121             ; Bomb spread distance\\nimp     equ icopy+1800      ; Imp start location  \\nhide    equ 1600            ; Vampire hide location\\n\\n; Trap and pit for vampire victims\\ntrap    jmp pit-x-121+2, x+121   ; Trap statement in front to foil tracers\\nx       spl 0,           trap\\n        mov @0,          @trap\\n        sub 4,           @-1\\n        jmp -2\\npit     mov @dist,       <0-dist\\n        spl 0                     ; This should change more losses into ties\\n        spl -1                    ; than wins into ties\\n\\n; Massive decoy field - 63 lines to slow down enemy djn scans\\n        dat     <trap,          <1      ; decoys\\n        dat     <trap,          <1      ; slow down enemy djn  \\n        dat     <trap,          <1      ; but don't cmp equal\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n        dat     <trap,          <1\\n\\n; Main execution - vampire setup and binary ring launcher  \\nstart   mov     trap+4,         hide            ; Copy vampire components\\n        mov     trap+3,         <start          ; to safe hide location\\n        mov     trap+2,         <start          \\n        mov     trap+1,         <start\\n        mov     trap,           <start\\n        mov     pit+2,          hide\\n        mov     pit+1,          <-1\\n        mov     pit,            <-2\\n        spl     start+hide-3,   <1              ; 1st split to vampire\\n\\n; Binary ring imp launcher - creates multiple imp streams\\nring    spl     9,              <4050           ; Binary tree startup\\n        spl     5,              <4100           \\n        spl     3,              <4150\\n        mov     icopy,          imp             ; Copy imp template away from decoys\\n        jmp     start+hide-3,   <4200           ; 2nd split to vampire\\n        jmp     imp,            <4250           ; Launch first imp stream\\n        spl     2,              <4300\\n        jmp     2667+imp,       <6350           ; Imp stream at 2667 interval\\n        jmp     5334+imp,       <4400           ; Imp stream at 5334 interval  \\n        spl     4,              <4450\\n        spl     2,              <4500\\n        jmp     1+imp,          <4550           ; Imp stream at +1 offset\\n        jmp     2668+imp,       <4600           ; Imp stream at 2668 interval\\n        spl     2,              <4650\\n        jmp     5335+imp,       <4700           ; Imp stream at 5335 interval\\n        jmp     2+imp,          <4750           ; Imp stream at +2 offset\\n\\n; Imp template\\nicopy   mov     0,              2667            ; Basic imp: mov 0, 2667\\n\\n        end     start;redcode-94\\n;name Stone\\n;author mzvince (Everything2)\\n;source https://everything2.com/title/bomber\\n;strategy Classic stone bomber - drops DAT every 4 positions\\n;assert CORESIZE == 8000\\n\\nstart   add #4, 3\\n        mov 2, @2  \\n        jmp -2\\n        dat #0, #0\\n        \\n        end start;redcode-94\\n;name Vampire\\n;author mzvince (Everything2)\\n;source https://everything2.com/node/581524 (with minor adjustments)\\n;strategy Vampire/pit-trapper: scatter fangs (JMP) that send enemy into a pit which clears.\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\n\\nconst   EQU     7\\n\\n        SPL     0                   ; prevent instant bomber kill\\nmain    MOV     ptr, @ptr           ; drop fang (JMP at B(ptr))\\n        ADD     data, ptr           ; advance pointer\\n        DJN     main, <2444         ; loop while stepping through core\\n\\nptr     JMP     trap, ptr           ; fang: jumps into our pit\\n\\ntrap    SPL     1, -100             ; slow replicators\\n        MOV     data, <-1           ; core-clear in the pit\\n        JMP     -2                  ; loop until overwritten\\n\\ndata    DAT     #const, #-const\\n        \\n        end main\\n===\\n===\\n�7zXZ\\u0000\\u0000\\u0004�ִF\\u0004��\\u001f��\\u0001!\\u0001\\u0016\\u0000\\u0000\\u0000\\u0000\\u0000\\u0000�4\\u000f��w�\\u000f�]\\u00002\\u0019Hm\\u0007��^*�O��JJNxY�\\u000by�s�\\u000e\\u0006\\u00022���t�N��)n�1\\u001f{ۨ�.$��K���3\\u000bE�����;<(G��<L7�-e1\\b���c�-\\u0005\\u0007��.;\\r�-K��J���\\u001d��sv�]�\\b�\\u0010\\u000f}��{��{���v\\fUXi,�e\\u0019����k\\u0019t���\\u000f�\\r+@\\u001b�R��ӓ\\f���K$�2[u�\\u001e*�\\u000b\\\\XڧQ�\\u001c���\\u0019�)𷚡_��Y�\\b\\u0012�lgk\\u0007.*u\\u0013����{�b7w�@�\\u0010>��:\\u0014�����\\u0001��P*�Y-t��\\u000f�3���\\u0015��uw�ꇋ\\u0015M/�if�|�\\u0014ĄgM\\u0001���0QƨM�H.�'���}s�C���lx\\u0001$\\fϷ���U�-g�>v����\\u0019n,\\u0019h�\\t��͠�\\u001c\\t:f�>�@����&\\u0003���p\\u001fj��֟�]N���jJ�*\\r\\\"�\\u0018���q\\u0016F�K\\u000b\\u0001\\u0016\\u0007Q_��91[i\\f�o�\\u0003\\u0003g\\u0014�j�K�F�\\u0018�ۚ�5�jd�����k�����N׹���\\u001d,x�8��q7�f@:\\u001e�Z d��h��t\\\"�Y6ߪ�H�i2\\\\S�ݰ\\u0007�����\\u0015\\u0012tT6�\\tE���������+�\\u000ek�k�\\u0006k���sD+\\u001e�9\\u0011Z�\\u000fj!y�K\\u000ft9�\\u001cp\\u0014�@�8#{�I<�L<�t���\\u0004vH��y2�5�(b\\u0017��\\r\\\\'��zƒ���k��i��\\u001d�n�\\u0018č��/�yH��\\u000fH'�?\\b\\bM\\\\\\tw\\u001d\\u0004-��3\\u000f��W~`���\\u000f���Ԋ�B��� ���s�@`o\\u001a����6�_��\\u0010�\\u000f~�\\u0000��9���h$�\\u0003���b��J���-�\\u001f#�W��-��؈AqW&:\\u0011�\\tב���lX�`�%pĚ���Y���H�pY\\u0015o�Ko�+Y\\u0015\\u0000\\u001ac|ٝS-�ޗ��.C�\\u0001#�3W�\\u0007�\\u0015���Q������z�S2�Ȅ~�\\u001e\\u0002�W��U~^�\\fr��H\\u001a:dd�4\\u0007��.'2��bIe�mm�`���4\\u0005���^\\u001fOc�x�R��(�m��I���T�QzEw��\\u0006$�NՓP0#�6\\u0014��\\\\:���֥(�R!�\\u0013%�$�$\\u0007]7�/�tS��\\u0019_����z\\r\\u000f\\n\\u0004\\u001d���,�\\u0011�\\u0012�Ѽ�l�T�C�L+�*�j2����qG\\u001d�(0\\u0015��\\u0016F���v�,���̏[H���轞Q�