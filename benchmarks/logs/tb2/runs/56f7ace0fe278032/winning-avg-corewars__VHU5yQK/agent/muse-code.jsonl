{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c412","stream":{"kind":"session","id":"3ec7841e-2ae3-4bb2-99ce-04ab6118879e"},"sequence":99,"recorded_at":1780531400000194,"record_type":"event","durability":"durable","causation_id":"01a190c1-ab59-7ab2-bfe1-6577f19d565c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a190c1-ab59-7ab2-bfe1-6577f19d565c","event":{"chunk":"Read text file `warriors/vampire.red`.\n1|;redcode-94\n2|;name Vampire\n3|;author mzvince (Everything2)\n4|;source https://everything2.com/node/581524 (with minor adjustments)\n5|;strategy Vampire/pit-trapper: scatter fangs (JMP) that send enemy into a pit which clears.\n6|;assert CORESIZE == 8000 && MAXCYCLES == 80000\n7|\n8|const   EQU     7\n9|\n10|        SPL     0                   ; prevent instant bomber kill\n11|main    MOV     ptr, @ptr           ; drop fang (JMP at B(ptr))\n12|        ADD     data, ptr           ; advance pointer\n13|        DJN     main, <2444         ; loop while stepping through core\n14|\n15|ptr     JMP     trap, ptr           ; fang: jumps into our pit\n16|\n17|trap    SPL     1, -100             ; slow replicators\n18|        MOV     data, <-1           ; core-clear in the pit\n19|        JMP     -2                  ; loop until overwritten\n20|\n21|data    DAT     #const, #-const\n22|        \n23|        end main","final_result":true,"kind":"output","task_id":"01a190c1-e5e3-7bc2-b0d1-cb6fa2d9f2c0"},"kind":"task_lifecycle","run_stream":{"id":"01a190c1-ab59-7ab2-bfe1-6577f19d565c","kind":"run"},"task_id":"01a190c1-e5e3-7bc2-b0d1-cb6fa2d9f2c0","task_stream":{"id":"01a190c1-e5e3-7bc2-b0d1-cb6fa2d9f2c0","kind":"task"}}}
