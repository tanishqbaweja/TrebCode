{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c40e","stream":{"kind":"session","id":"3ec7841e-2ae3-4bb2-99ce-04ab6118879e"},"sequence":97,"recorded_at":1780531400000190,"record_type":"event","durability":"durable","causation_id":"01a190c1-ab59-7ab2-bfe1-6577f19d565c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a190c1-ab59-7ab2-bfe1-6577f19d565c","event":{"chunk":"Read text file `warriors/stone.red`.\n1|;redcode-94\n2|;name Stone\n3|;author mzvince (Everything2)\n4|;source https://everything2.com/title/bomber\n5|;strategy Classic stone bomber - drops DAT every 4 positions\n6|;assert CORESIZE == 8000\n7|\n8|start   add #4, 3\n9|        mov 2, @2  \n10|        jmp -2\n11|        dat #0, #0\n12|        \n13|        end start","final_result":true,"kind":"output","task_id":"01a190c1-e4cb-7bb1-878c-352469f0eecc"},"kind":"task_lifecycle","run_stream":{"id":"01a190c1-ab59-7ab2-bfe1-6577f19d565c","kind":"run"},"task_id":"01a190c1-e4cb-7bb1-878c-352469f0eecc","task_stream":{"id":"01a190c1-e4cb-7bb1-878c-352469f0eecc","kind":"task"}}}
