{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c416","stream":{"kind":"session","id":"3ec7841e-2ae3-4bb2-99ce-04ab6118879e"},"sequence":101,"recorded_at":1780531400000198,"record_type":"event","durability":"durable","causation_id":"01a190c1-ab59-7ab2-bfe1-6577f19d565c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a190c1-ab59-7ab2-bfe1-6577f19d565c","event":{"chunk":"Read text file `warriors/paper.red`.\n1|;redcode-94\n2|;name Paper\n3|;author mzvince (Everything2)\n4|;source https://everything2.com/title/corewars+replicator\n5|;strategy Classic paper replicator - fast copying beats stone bombers  \n6|;assert CORESIZE == 8000\n7|\n8|step    equ 2667    ; coprime step for full coverage\n9|\n10|start   spl 1       ; split for more processes\n11|        \n12|loop    mov copy, *ptr\n13|        add #1, ptr\n14|        mov copy, @ptr\n15|        add #step, ptr\n16|        jmp loop\n17|\n18|copy    spl 0, 0\n19|ptr     dat step, step*2\n20|\n21|        end start","final_result":true,"kind":"output","task_id":"01a190c1-e556-7e91-9bc4-540b5790ce22"},"kind":"task_lifecycle","run_stream":{"id":"01a190c1-ab59-7ab2-bfe1-6577f19d565c","kind":"run"},"task_id":"01a190c1-e556-7e91-9bc4-540b5790ce22","task_stream":{"id":"01a190c1-e556-7e91-9bc4-540b5790ce22","kind":"task"}}}
