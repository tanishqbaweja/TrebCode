-key-2024\"\n\nfail() { echo \"ERROR: $1\" >&2; exit 1; }\n\ntrap 'echo \"ERROR: Migration failed at line $LINENO\" >&2; rm -rf \"$STAGING\" 2>/dev/null || true' ERR\n\n[ -d \"$SRC\" ] || fail \"Source directory $SRC not found\"\n[ \"$(ls -A \"$SRC\" 2>/dev/null)\" ] || fail \"Source directory $SRC is empty\"\n\n# --- Phase 1: checksums + metadata ---\necho \"Phase 1: Generating checksums and metadata...\"\nrm -rf \"$STAGING\"\nrm -f checksums.sha256 metadata.json /tmp/checksums.sha256 /tmp/metadata.json 2>/dev/null || true\n\npython3 << 'PYEOF'\nimport os, hashlib, json, datetime\nsrc = \"/var/lib/legacy_database\"\nfiles = sorted([f for f in os.listdir(src) if os.path.isfile(os.path.join(src, f))])\nif not files:\n    raise SystemExit(\"ERROR: No files found in source directory\")\nentries = []\ntotal = 0\nlines = []\nfor fn in files:\n    fp = os.path.join(src, fn)\n    size = os.path.getsize(fp)\n    total += size\n    h = hashlib.sha256()\n    with open(fp, \"rb\") as f:\n        for chunk in iter(lambda: f.read(8192), b\"\"):\n            h.update(chunk)\n    digest = h.hexdigest()\n    entries.append({\"filename\": fn, \"size_bytes\": size, \"sha256\": digest})\n    lines.append(f\"{digest}  {fn}\")\nwith open(\"checksums.sha256\", \"w\") as out:\n    out.write(\"\\n\".join(lines) + \"\\n\")\nwith open(\"/tmp/checksums.sha256\", \"w\") as out:\n    out.write(\"\\n\".join(lines) + \"\\n\")\ntimestamp = datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\nmeta = {\n    \"migration_timestamp\": timestamp,\n    \"source_directory\": src,\n    \"file_count\": len(files),\n    \"total_size_bytes\": total,\n    \"files\": entries\n}\nwith open(\"metadata.json\", \"w\") as out:\n    json.dump(meta, out, indent=2)\n    out.write(\"\\n\")\nwith open(\"/tmp/metadata.json\", \"w\") as out:\n    json.dump(meta, out, indent=2)\n    out.write(\"\\n\")\nprint(f\"Generated checksums for {len(files)} files, total {total} bytes\")\nPYEOF\ncat checksums.sha256\ncat metadata.json\n\n# --- Phase 2: staging + archive ---\necho \"Phase 2: Creating archive...\"\nmkdir -p \"$STAGING/database\"\ncp checksums.sha256 \"$STAGING/checksums.sha256\" || fail \"Failed to stage checksums.sha256\"\ncp metadata.json \"$STAGING/metadata.json\" || fail \"Failed to stage metadata.json\"\ncp \"$SRC\"/* \"$STAGING/database/\" || fail \"Failed to stage database files\"\nls -R \"$STAGING\"\nrm -f \"$ARCHIVE\" /tmp/migration_archive.tar 2>/dev/null || true\ntar -cf /tmp/migration_archive.tar -C \"$STAGING\" checksums.sha256 metadata.json database || fail \"Failed to create tar archive\"\ngzip -9 -c /tmp/migration_archive.tar > \"$ARCHIVE\" || fail \"Failed to compress archive with gzip -9\"\nrm -f /tmp/migration_archive.tar\nls -lh \"$ARCHIVE\"\nrm -rf \"$STAGING\" || fail \"Failed to clean up staging directory\"\n[ ! -e \"$STAGING\" ] || fail \"Staging directory still exists after cleanup\"\necho \"Archive created at $ARCHIVE\"\n\n# --- Phase 3: encryption + audit log ---\necho \"Phase 3: Encrypting archive...\"\nmkdir -p /secure\nrm -f \"$ENCRYPTED\" 2>/dev/null || true\ngpg --batch --yes --no-tty --symmetric --cipher-algo AES256 --passphrase \"$PASSPHRASE\" -o \"$ENCRYPTED\" \"$ARCHIVE\" || fail \"GPG encryption failed\"\n[ -f \"$ENCRYPTED\" ] || fail \"Encrypted file not created\"\nSRC_SIZE=$(stat -c%s \"$ARCHIVE\")\nENC_SIZE=$(stat -c%s \"$ENCRYPTED\")\nTIMESTAMP=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\nmkdir -p /var/log\ncat > /var/log/migration_audit.log << EOF\n=== Migration Audit Log ===\nTimestamp: $TIMESTAMP\nSource Archive: $ARCHIVE\nSource Size: $SRC_SIZE bytes\nEncrypted File: $ENCRYPTED\nEncrypted Size: $ENC_SIZE bytes\nCipher Algorithm: AES256\nStatus: SUCCESS\nEOF\ncat /var/log/migration_audit.log\n\n# --- Phase 4: verification script ---\necho \"Phase 4: Creating verification script...\"\ncat > /secure/verify_migration.sh << 'VEOF'\n#!/bin/bash\nset -e\nENCRYPTED_FILE=\"/secure/database_backup.gpg\"\nPASSPHRASE=\"migration-key-2024\"\nTMPFILE=$(mktemp) || { echo \"ERROR: Failed to create temp file\" >&2; exit 1; }\nTMPDIR=$(mktemp -d) || { echo \"ERROR: Failed to create temp directory\" >&2; rm -f \"$TMPFILE\"; exit 1; }\ncleanup() {\n  rm -f \"$TMPFILE\"\n  rm -rf \"$TMPDIR\"\n}\ntrap cleanup EXIT\ngpg --batch --yes --no-tty --passphrase \"$PASSPHRASE\" -d -o \"$TMPFILE\" \"$ENCRYPTED_FILE\" || { echo \"ERROR: Decryption failed\" >&2; exit 1; }\nmkdir -p \"$TMPDIR/extract\"\ntar -xzf \"$TMPFILE\" -C \"$TMPDIR/extract\" || { echo \"ERROR: Extraction failed\" >&2; exit 1; }\nCHECKSUM_FILE=\"$TMPDIR/extract/checksums.sha256\"\nDB_DIR=\"$TMPDIR/extract/database\"\n[ -f \"$CHECKSUM_FILE\" ] || { echo \"ERROR: checksums.sha256 not found in archive\" >&2; exit 1; }\n[ -d \"$DB_DIR\" ] || { echo \"ERROR: database directory not found in archive\" >&2; exit 1; }\necho \"Verifying migration backup...\"\nPASSED=0\nTOTAL=0\nwhile IFS= read -r line || [ -n \"$line\" ]; do\n  [ -z \"$line\" ] && continue\n  EXPECTED=$(echo \"$line\" | awk '{print $1}')\n  FILENAME=$(echo \"$line\" | awk '{print $2}')\n  [ -z \"$EXPECTED\" ] && continue\n  [ -z \"$FILENAME\" ] && continue\n  TOTAL=$((TOTAL + 1))\n  TARGET=\"$DB_DIR/$FILENAME\"\n  if [ ! -f \"$TARGET\" ]; then\n    echo \"[FAIL] $FILENAME: file missing\"\n    continue\n  fi\n  ACTUAL=$(sha256sum \"$TARGET\" | awk '{print $1}')\n  if [ \"$ACTUAL\" = \"$EXPECTED\" ]; then\n    echo \"[PASS] $FILENAME: checksum verified\"\n    PASSED=$((PASSED + 1))\n  else\n    echo \"[FAIL] $FILENAME: checksum mismatch\"\n  fi\ndone < \"$CHECKSUM_FILE\"\necho \"Verification complete: $PASSED/$TOTAL files passed\"\nif [ \"$PASSED\" -eq \"$TOTAL\" ] && [ \"$TOTAL\" -gt 0 ]; then\n  exit 0\nelse\n  exit 1\nfi\nVEOF\nchmod +x /secure/verify_migration.sh || fail \"Failed to make verification script executable\"\nls -l /secure/verify_migration.sh\n\n# --- Test verification script before destructive Phase 5 ---\necho \"Testing verification script...\"\n/secure/verify_migration.sh || fail \"Verification script failed before secure deletion\"\n\n# --- Phase 5: secure deletion ---\necho \"Phase 5: Secure deletion...\"\nfor f in \"$SRC\"/*; do\n  [ -e \"$f\" ] || continue\n  [ -f \"$f\" ] || continue\n  shred -vzn 3 -u \"$f\" || fail \"Failed to shred $f\"\ndone\nshred -vzn 3 -u \"$ARCHIVE\" || fail \"Failed to shred intermediate archive $ARCHIVE\"\nrmdir \"$SRC\" || fail \"Failed to remove empty directory $SRC\"\n[ ! -e \"$SRC\" ] || fail \"Source directory still exists after rmdir\"\nif [ -e /etc/database.conf ]; then\n  shred -vzn 3 -u /etc/database.conf || fail \"Failed to shred /etc/database.conf\"\nfi\nif [ -e /tmp/db_manifest.txt ]; then\n  shred -vzn 3 -u /tmp/db_manifest.txt || fail \"Failed to shred /tmp/db_manifest.txt\"\nfi\nrm -f /tmp/db_* 2>/dev/null || true\n# also clean temp metadata copies if they match pattern? /tmp/metadata.json and /tmp/checksums.sha256 do not match db_*, keep them. Remove tar leftover if any.\nrm -f /tmp/migration_archive.tar 2>/dev/null || true\nls -la /tmp/ || true\n\n# --- Phase 6: status + cleanup ---\necho \"Phase 6: Post-migration cleanup...\"\nFILE_COUNT=$(python3 -c \"import json; print(json.load(open('metadata.json'))['file_count'])\")\nTOTAL_SIZE=$(python3 -c \"import json; print(json.load(open('metadata.json'))['total_size_bytes'])\")\nCOMPLETION=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\ncat > /secure/migration_complete.status << EOF\nMigration Status Report\n=======================\nCompletion Time: $COMPLETION\nFiles Migrated: $FILE_COUNT\nTotal Data Size: $TOTAL_SIZE bytes\nEncrypted Backup: /secure/database_backup.gpg\nVerification Script: /secure/verify_migration.sh\nStatus: SUCCESS\nEOF\ncat /secure/migration_complete.status\n# Unset any env vars containing database credentials\nfor var in $(env | cut -d= -f1); do\n  case \"$var\" in\n    *[Dd][Bb]*|*database*|*DATABASE*|*Database*|*cred*|*CRED*|*pass*|*PASS*|*Pass*)\n      unset \"$var\" 2>/dev/null || true\n      ;;\n  esac\ndone\nunset db_host db_port db_user db_password db_name DB_HOST DB_PORT DB_USER DB_PASSWORD DB_NAME DATABASE_URL 2>/dev/null || true\necho \"Migration completed successfully\""}}}
