y[i % len(key)] for i, b in enumerate(data))\n\nfragdir='/app/backup_fragments'\noutdir='/app/restored_backups'\nos.makedirs(outdir, exist_ok=True)\nfrom collections import defaultdict\ngroups=defaultdict(list)\nfor f in sorted(os.listdir(fragdir)):\n    if f.endswith('_corrupted.frag'):\n        print(f'skip {f}')\n        continue\n    base=f[:-len('.frag')]\n    nh, sh = base.split('_')\n    oname = xor_decrypt(bytes.fromhex(nh), fname_key).decode()\n    sseq = xor_decrypt(bytes.fromhex(sh), fname_key).decode()\n    # parse SEQ:NNN/TTT\n    assert sseq.startswith('SEQ:'), sseq\n    nnn, ttt = sseq[4:].split('/')\n    fn_seq, fn_total = int(nnn), int(ttt)\n    ckey = sql_key if oname.endswith('.sql') else json_key\n    raw=open(os.path.join(fragdir,f)).read().strip()\n    dec=xor_decrypt(bytes.fromhex(raw), ckey)\n    cksum=dec[0:4]; seq,total = struct.unpack('>HH', dec[4:8]); data=dec[8:]\n    assert hashlib.md5(data).digest()[:4]==cksum, f'checksum fail {f}'\n    assert seq==fn_seq and total==fn_total, f'header/filename mismatch {f}: {seq}/{total} vs {fn_seq}/{fn_total}'\n    groups[oname].append((seq,total,data))\n\nfor oname, frags in groups.items():\n    frags_sorted=sorted(frags)\n    totals=set(t for _,t,_ in frags_sorted)\n    assert len(totals)==1, totals\n    total=totals.pop()\n    assert len(frags_sorted)==total, f'{oname}: have {len(frags_sorted)} want {total}'\n    assert [s for s,_,_ in frags_sorted]==list(range(1,total+1))\n    blob=b''.join(d for _,_,d in frags_sorted)\n    out=os.path.join(outdir, oname)\n    # write bytes; assume utf-8 text\n    open(out,'wb').write(blob)\n    print(f'wrote {out} {len(blob)} bytes from {total} frags')\n\n# validation\nfor fn in ['users_table.sql','orders_table.sql','config_backup.json']:\n    p=os.path.join(outdir,fn)\n    print(fn, os.path.exists(p), os.path.getsize(p) if os.path.exists(p) else '-')\n    if fn.endswith('.json'):\n        json.load(open(p))\n        print('  valid JSON')\n    else:\n        t=open(p).read()\n        print('  has CREATE TABLE:', 'CREATE TABLE' in t, 'has INSERT:', 'INSERT' in t)\nPY\nls -l /app/restored_backups/"}}}
