clue, n):\n    if not clue:\n        return [[0]*n]\n    k = len(clue)\n    min_len = sum(clue) + (k-1)\n    free = n - min_len\n    res = []\n    # distribute free spaces into k+1 gaps (leading, internal-extra, trailing)\n    # Use recursion over gap allocations\n    def rec(idx, remaining, gaps):\n        if idx == k:\n            gaps.append(remaining)\n            # build pattern\n            pat = []\n            pat += [0]*gaps[0]\n            for i, b in enumerate(clue):\n                pat += [1]*b\n                if i < k-1:\n                    pat += [0]*(1+gaps[i+1])\n                else:\n                    pat += [0]*gaps[i+1]\n            assert len(pat)==n\n            res.append(pat)\n            gaps.pop()\n            return\n        for v in range(remaining+1):\n            gaps.append(v)\n            rec(idx+1, remaining-v, gaps)\n            gaps.pop()\n    rec(0, free, [])\n    return res\n\nrow_pats = [gen_patterns(c, cols) for c in row_clues]\ncol_pats = [gen_patterns(c, rows) for c in col_clues]\nprint('row counts', [len(x) for x in row_pats])\nprint('col counts', [len(x) for x in col_pats])\n\n# Backtracking: order rows by fewest patterns; maintain col prefix filtering\norder = sorted(range(rows), key=lambda r: len(row_pats[r]))\n# For fast col filtering, keep list of possible col patterns filtered by assigned rows\nfrom functools import lru_cache\n\n# Precompute as tuples\nrow_pats = [[tuple(x) for x in lst] for lst in row_pats]\ncol_pats = [[tuple(x) for x in lst] for lst in col_pats]\n\ngrid = [None]*rows\n\n# col possible sets, updated incrementally\ncol_possible = [list(range(len(col_pats[c]))) for c in range(cols)]\n\nimport sys\nsys.setrecursionlimit(10000)\n\ndef solve(pos):\n    if pos == rows:\n        # verify cols exactly match some pattern (already filtered, but check)\n        for c in range(cols):\n            col = tuple(grid[r][c] for r in range(rows))\n            if col not in set(col_pats[c]):\n                return False\n        return True\n    r = order[pos]\n    # Try each row pattern, check col consistency\n    for pat in row_pats[r]:\n        grid[r] = list(pat)\n        # filter col possibilities\n        saved = []\n        ok = True\n        for c in range(cols):\n            v = pat[c]\n            new_list = [i for i in col_possible[c] if col_pats[c][i][r]==v]\n            if not new_list:\n                ok=False\n                # need to restore before break: restore saved so far\n                # do restore below using saved\n                saved.append((c, col_possible[c]))\n                col_possible[c] = new_list\n                break\n            saved.append((c, col_possible[c]))\n            col_possible[c] = new_list\n        if ok and solve(pos+1):\n            return True\n        # restore\n        for c, old in saved:\n            col_possible[c] = old\n        grid[r] = None\n        if not ok:\n            # also need restore already? done\n            pass\n    return False\n\nif solve(0):\n    out = [grid[r] for r in range(rows)]\n    # validate\n    def blocks(line):\n        b=[]; cnt=0\n        for v in line:\n            if v==1: cnt+=1\n            elif cnt: b.append(cnt); cnt=0\n        if cnt: b.append(cnt)\n        return b\n    for r in range(rows):\n        assert blocks(out[r])==row_clues[r], (r, blocks(out[r]), row_clues[r])\n    for c in range(cols):\n        col=[out[r][c] for r in range(rows)]\n        assert blocks(col)==col_clues[c], (c, blocks(col), col_clues[c])\n    print('solved')\n    for row in out: print(row)\n    with open('/app/solution.json','w') as f:\n        json.dump(out, f)\n    print('written')\nelse:\n    print('NO SOLUTION')\nPY\npython3 /tmp/solve.py"}}}
